#pad: to debug errors in config/auto-aux/*.c you can
# export verbose=yes and rerun ./configure

##############################################################################
# Command line variables and their default values
##############################################################################

bindir=/usr/local/bin
libdir=/usr/local/lib/ocaml
mandir=/usr/local/man/man1
manext=1

host_type=unknown
target_arch=''

cc=''
cclibs=''
x11_include_dir=''
x11_lib_dir=''
posix_threads=no

# TODO? -Wno-unused?
# need gnu89 otherwise gcc15 complains a lot about function with
# wrong number of arguments (e.g. in interprete.c)
# alt: we could add the --std only when we detect gcc > 15 
gcc_warnings="-Wall --std=gnu89"

##############################################################################
# Parse command-line arguments
##############################################################################

#TODO: support -as, -aspp, -partialld so can run for example from INSTALL.adoc:
#    * On a Linux x86-64 host, to build a 32-bit version of OCaml:
#          ./configure -cc "gcc -m32" -as "as --32" -aspp "gcc -m32 -c" \
#                -host i386-linux -partialld "ld -r -melf_i386"

# claude: -target-arch lets the native-code compiler target an arch other
# than $host's own default (see "Configure the native-code compiler"): a
# 64-bit host (x86_64, aarch64) has no native-code backend of its own yet
# and gets "not supported" unless -target-arch explicitly asks for a
# cross target, e.g. -target-arch i386 to cross-compile i386 binaries
# from this aarch64 host using the installed i686-linux-gnu-gcc/as
# toolchain.

# claude: kept in sync by hand with the case branches below -- there is
# no single source of truth to generate this from in plain sh.
usage () {
  cat <<EOF
Usage: configure [options]
Options are:
  -bindir <dir>       Install binaries in <dir> (default $bindir)
  -libdir <dir>       Install the standard library in <dir> (default $libdir)
  -mandir <dir>       Install man pages in <dir> (default $mandir)
  -host <host>        Configure for the given host type
                      (default: guessed by config.guess)
  -target-arch <arch> Cross-compile the native-code compiler for <arch>
                      instead of \$host's own default (which is "not
                      supported" for a 64-bit host such as x86_64 or
                      aarch64, since neither has a native backend yet).
                      Supported: i386, arm (or arm32), mips, alpha, m68k,
                      sparc, power (or powerpc).
                      Example: -target-arch i386 on an aarch64 host
                      cross-compiles i386 binaries using the installed
                      i686-linux-gnu-gcc/as toolchain. -target-arch mips
                      cross-compiles mipsel (little-endian, o32 ABI)
                      binaries using the installed mipsel-linux-gnu-gcc/as
                      toolchain. -target-arch alpha cross-compiles using
                      the installed alpha-linux-gnu-gcc/as toolchain.
                      -target-arch m68k cross-compiles (68020+/68881)
                      using the installed m68k-linux-gnu-gcc/as toolchain.
                      -target-arch sparc cross-compiles using the
                      installed sparc64-linux-gnu-gcc/as toolchain (in
                      -m32 mode, i.e. 32-bit sparc v8/v9 code).
                      -target-arch power cross-compiles using the
                      installed powerpc-linux-gnu-gcc/as toolchain.
  -cc <compiler>      Use <compiler> as the C compiler for the bytecode
                      compiler's "custom runtime" mode
  -lib <libs>         Link the bytecode "custom runtime" mode with <libs>
  -x11include <dir>   Search <dir> for the X11 include files
  -x11lib <dir>       Search <dir> for the X11 library files
  -with-pthread       Use POSIX threads for the "threads" library
  -help, --help       Show this help and exit
EOF
}

while : ; do
  case "$1" in
    "") break;;
    -help|--help)
        usage; exit 0;;
    -bindir|--bindir)
        bindir=$2; shift;;
    -libdir|--libdir)
        libdir=$2; shift;;
    -mandir|--mandir)
        mandir=$2
        manext=`echo $mandir | sed -e 's/^.*\(.\)$/\1/'`
        shift;;
    -host*|--host*)
        host_type=$2; shift;;
    -target-arch*|--target-arch*)
        target_arch=$2; shift;;
    -cc*)
        cc="$2"; shift;;
    -lib*)
        cclibs="$2 "; shift;;
    -x11include*|--x11include*)
        x11_include_dir=$2; shift;;
    -x11lib*|--x11lib*)
        x11_lib_dir=$2; shift;;
    -with-pthread*|--with-pthread*)
        posix_threads=yes;;
    *) echo "Unknown option \"$1\"." 1>&2
       echo "Try './configure -help' for a list of options." 1>&2
       exit 2;;
  esac
  shift
done

# Sanity checks

case "$bindir" in
  /*) ;;
   *) echo "The -bindir directory must be absolute." 1>&2; exit 2;;
esac
case "$libdir" in
  /*) ;;
   *) echo "The -libdir directory must be absolute." 1>&2; exit 2;;
esac
case "$mandir" in
  /*) ;;
   *) echo "The -mandir directory must be absolute." 1>&2; exit 2;;
esac

##############################################################################
# Generate the files
##############################################################################

# !!!Changing directory!!!
cd config/auto-aux

rm -f s.h m.h Makefile
touch s.h m.h Makefile

# Where to install

echo "BINDIR=$bindir" >> Makefile
echo "LIBDIR=$libdir" >> Makefile
echo "MANDIR=$mandir" >> Makefile
echo "MANEXT=$manext" >> Makefile

##############################################################################
# Determine the system type (from config/auto-aux/)
##############################################################################

if test "$host_type" = "unknown"; then
  if host_type=`./config.guess`; then :; else
    echo "Cannot guess host type"
    echo "You must specify one with the -host option"
    exit 2
  fi
fi
if host=`./config.sub $host_type`; then :; else
  echo "Please specify the correct host type with the -host option"
  exit 2
fi
echo "Configuring for a $host ..."

# Do we have gcc?

if test -z "$cc"; then
  if sh ./searchpath gcc; then
    echo "gcc found"
    cc=gcc
  else
    cc=cc
  fi
fi

##############################################################################
# Configure the bytecode compiler
##############################################################################

bytecc="$cc"
bytecccompopts=""
bytecclinkopts=""

case "$bytecc,$host" in
  gcc,*-*-darwin*)
    bytecccompopts="-Wno-format $gcc_warnings";;
  gcc*)
    bytecccompopts="-fno-defer-pop $gcc_warnings";;
esac

echo "BYTECC=$bytecc" >> Makefile
echo "BYTECCCOMPOPTS=$bytecccompopts" >> Makefile
echo "BYTECCLINKOPTS=$bytecclinkopts" >> Makefile

# Configure compiler to use in further tests

#pad: recent compilers (gcc, clang) use new defaults that prevent to compile
# the test code in config/auto-aux/*.c hence those -Wno-xxx below
#alt: fix config/auto-aux/*.c to be compliant with the new C23 standard
# by either including appropriate .h or just add prototypes of used functions
cc="$bytecc $bytecclinkopts -Wno-implicit-function-declaration -Wno-implicit-int"
export cc cclibs

# Check C compiler

sh ./runtest ansi.c
case $? in
  0) echo "The C compiler is ANSI-compliant.";;
  1) echo "The C compiler $cc is not ANSI-compliant."
     echo "You need an ANSI C compiler to build OCaml light."
     exit 2;;
  *) echo "Unable to compiler the test program."
     echo "Make sure the C compiler $cc is properly installed."
     exit 2;;
esac

# Check the sizes of data types

echo "Checking the sizes of integers and pointers..."
set `sh ./runtest sizes.c`
case "$1,$2,$3" in
  4,4,4) echo "OK, this is a regular 32 bit architecture."
         echo "#undef ARCH_SIXTYFOUR" >> m.h;;
  4,8,8) echo "Wow! A 64 bit architecture!"
         
         case "$bytecc" in
	     gcc)
		 #pad: this allows to compile ocamlrun in 64bit and asmrun
		 # in 32bit.
		 #alt: use -m32 for bytegcc too and undef ARCH_SIXTYFOUR
		 # (but got weird problems with ocamlrun compiled with -m32)
		 # claude: byterun/*.c and asmrun/*.c share this single m.h
		 # (asmrun/*.c are literal symlinks to byterun/*.c, see
		 # asmrun/Makefile), but they can be built by two different
		 # compilers: byterun is always built by the *native* host
		 # gcc ($bytecc), while asmrun, when cross-compiling the
		 # native-code backend to another arch (e.g. arm from this
		 # aarch64 host), is built by a *different*, target gcc
		 # (NATIVECC, e.g. arm-linux-gnueabihf-gcc). A single
		 # "#define ARCH_SIXTYFOUR" or "#undef" can't be right for
		 # both at once when the two disagree on word size. So
		 # instead of baking in one answer at configure time, emit
		 # a #if keyed on compiler-predefined arch macros, which
		 # each of the two compiles resolves independently and
		 # correctly for itself when this header is included.
		 # This used to also be gated on `$host` matching specific
		 # 64-bit host triples (originally just x86_64-*-linux*),
		 # so ARCH_SIXTYFOUR was unconditionally #defined (no #if
		 # guard at all, see the catch-all case below) on any other
		 # host -- including aarch64-*-linux* hosts such as this
		 # "thelio astra" machine. That unconditional define then
		 # also applied to compiling asmrun/*.c for the 32-bit ARM
		 # target, making every header/size macro in mlvalues.h
		 # (Wosize_hd, Bosize_hd, etc.) use 64-bit-word assumptions
		 # on a 32-bit runtime -- corrupting heap block sizes and
		 # pointers (by exactly one extra bit, 1 << 24, in the case
		 # that tracked this down) and crashing on the very first
		 # native heap allocation. Keying this off $bytecc alone
		 # (any host gcc) avoids having to keep extending a list of
		 # known 64-bit host triples by hand.
		 # claude: added __alpha__ for -target-arch alpha (see
		 # configure's -target-arch handling below) -- alpha is a
		 # genuine 64-bit architecture (asmcomp/alpha/arch.ml's
		 # size_int/size_addr = 8), so asmrun/*.c compiled by
		 # alpha-linux-gnu-gcc needs ARCH_SIXTYFOUR defined, same
		 # reasoning as x86_64/aarch64/riscv64 above.
		 echo "#if defined(__x86_64__) || defined(_M_X64) || \\" >> m.h
		 echo "     defined(__aarch64__) || defined(__alpha__) || \\" >> m.h
		 echo "     (defined(__riscv) && __riscv_xlen == 64)" >> m.h
		 echo "#define ARCH_SIXTYFOUR" >> m.h
		 echo "#endif" >> m.h;;
             *)
		 echo "#define ARCH_SIXTYFOUR" >> m.h
		 echo "#undef ARCH_CODE32" >> m.h;;
         esac;;
  8,*,*) echo "Wow! A 64 bit architecture!"
         echo "Unfortunately, OCaml light does not handle the case"
         echo "sizeof(int) = 8."
         echo "OCaml light won't run on this architecture."
         exit 2;;
  *,*,8) echo "Wow! A 64 bit architecture!"
         echo "Unfortunately, OCaml light cannot work in the case"
         echo "sizeof(long) != sizeof(long *)."
         echo "OCaml light won't run on this architecture."
         exit 2;;
  *,*,*) echo "This architecture seems to be neither 32 bits nor 64 bits."
         echo "OCaml light won't run on this architecture."
         exit 2;;
      *) echo "Unable to compile the test program."
         echo "Make sure the C compiler $cc is properly installed."
         exit 2;;
esac

# Determine endianness

# claude: same cross-compilation trap as ARCH_SIXTYFOUR/ARCH_ALIGN_DOUBLE
# above -- `runtest` runs endian.c natively on the host (aarch64, little-
# endian), which says nothing about the target of a cross native-code
# build. This was never wrong before (every prior -target-arch: i386,
# arm, mips, alpha, is little-endian, matching every host this has been
# built on), so it went unnoticed; -target-arch m68k, sparc and power
# are big-endian (asmcomp/{m68k,sparc,power}/arch.ml's big_endian = true)
# and need asmrun/*.c (compiled by m68k-linux-gnu-gcc /
# sparc64-linux-gnu-gcc / powerpc-linux-gnu-gcc, which predefine
# __m68k__ / __sparc__ / __powerpc__ respectively) to agree, regardless
# of what the (little-endian) host determined for itself.
sh ./runtest endian.c
case $? in
  0) echo "This is a big-endian architecture."
     host_endian_directive="#define ARCH_BIG_ENDIAN";;
  1) echo "This is a little-endian architecture."
     host_endian_directive="#undef ARCH_BIG_ENDIAN";;
  2) echo "This architecture seems to be neither big endian nor little endian."
     echo "OCaml light won't run on this architecture."
     exit 2;;
  *) echo "Something went wrong during endianness determination."
     echo "You'll have to figure out endianness yourself"
     echo "(option ARCH_BIG_ENDIAN in m.h)."
     host_endian_directive="#undef ARCH_BIG_ENDIAN";;
esac
echo "#if defined(__m68k__) || defined(__sparc__) || defined(__powerpc__)" >> m.h
echo "#define ARCH_BIG_ENDIAN" >> m.h
echo "#else" >> m.h
echo "$host_endian_directive" >> m.h
echo "#endif" >> m.h

# Determine alignment constraints

# claude: same cross-compilation trap as ARCH_SIXTYFOUR above. `runtest`
# compiles and *runs* dblalign.c with $cc, i.e. natively on the host
# (aarch64 here) -- it says nothing about whether the target of a cross
# native-code build (arm-linux-gnueabihf here) needs doubleword-aligned
# doubles. aarch64 tolerates a misaligned double fine, so this test used
# to unconditionally #undef ARCH_ALIGN_DOUBLE, and that #undef then also
# applied when compiling asmrun/*.c for arm. But ARM's AAPCS float ABI
# does not: an ARM LDRD (used e.g. by gcc to pass a boxed OCaml float as
# a double argument to a variadic C function like sprintf, since AAPCS
# variadic args always go through core registers, never VFP, regardless
# of -mfloat-abi=hard) silently reads the wrong bits from a
# word-aligned-but-not-doubleword-aligned address. Concretely: an OCaml
# float box landed at 0x437f34 (word-aligned, %8 == 4) here, and the
# very next sprintf("%.12g", that double) printed "2.16910112697e-307"
# instead of "3.14" -- everything upstream of that call (the box's raw
# bits, the register values right before the call) was already verified
# correct. Without ARCH_ALIGN_DOUBLE, mlvalues.h/alloc_shr/etc. don't
# bother rounding float-block addresses up to 8 bytes. As with
# ARCH_SIXTYFOUR, resolve this per-compile with a #if on a
# compiler-predefined macro rather than baking in one host-wide answer:
# arm-linux-gnueabihf-gcc (used for asmrun/*.c) predefines __arm__, the
# native host gcc (used for byterun/*.c) does not, so each of the two
# gets the alignment rule that's actually correct for its own target,
# with the runtest-determined value kept as the fallback for everything
# else (including a native, non-cross arm build, where __arm__ would be
# predefined for byterun too and this forces alignment there as well --
# which is exactly what's wanted, since it would then actually be
# asmrun's ABI too).
sh ./runtest dblalign.c
case $? in
  0) echo "Doubles can be word-aligned (on this host)."
     dblalign_host_directive="#undef ARCH_ALIGN_DOUBLE";;
  1) echo "Doubles must be doubleword-aligned (on this host)."
     dblalign_host_directive="#define ARCH_ALIGN_DOUBLE";;
  *) echo "Something went wrong during alignment determination for doubles."
     echo "I'm going to assume this architecture has alignment constraints over doubles."
     echo "That's a safe bet: OCaml light will work even if"
     echo "this architecture has actually no alignment constraints."
     dblalign_host_directive="#define ARCH_ALIGN_DOUBLE";;
esac
# claude: same reasoning as the __arm__ case above, for the mipsel
# cross target added by -target-arch mips: MIPS's ldc1/sdc1 (used to
# load/store a boxed OCaml float as a double) fault on an address that
# isn't 8-byte aligned, so mipsel-linux-gnu-gcc (asmrun/*.c) needs
# ARCH_ALIGN_DOUBLE regardless of what the runtest probe found on the
# (unrelated) host CPU. Same for -target-arch sparc and -target-arch
# power: their load/store-double instructions (ldd/std on sparc, lfd/
# stfd on power) trap the same way on a word-aligned-but-not-
# doubleword-aligned address, and size_int (4) < size_float (8) for
# both, unlike alpha below.
#
# claude: deliberately NOT listing __alpha__ here (an earlier version of
# this comment did, reasoning "Alpha traps on unaligned float access" by
# analogy with arm/mips -- true, but beside the point). Every heap block
# is already word-aligned by construction (alloc()/alloc_shr() lay blocks
# out in whole "value" words), and on Alpha size_addr = size_float = 8,
# so that word alignment already IS double alignment; ARCH_ALIGN_DOUBLE
# is only needed where a word is *smaller* than a double (arm/mips: 4
# vs. 8). Defining it for Alpha anyway actively breaks things: byterun/
# floats.c's ARCH_ALIGN_DOUBLE-guarded Double_val/Store_double_val
# hardcode "sizeof(double) == 2*sizeof(value)" (true at word=4, false at
# word=8) via a `union { value v[2]; double d; }` -- Store_double_val
# then writes a second, uninitialized "value" past every float array
# element, corrupting whatever follows it in the block (observed:
# reading back an all-zero header/tag on the very next native-compiled
# program that populated a float array, i.e. test/fft.ml).
echo "#if defined(__arm__) || defined(__mips__) || defined(__sparc__) || defined(__powerpc__)" >> m.h
echo "#define ARCH_ALIGN_DOUBLE" >> m.h
echo "#else" >> m.h
echo "$dblalign_host_directive" >> m.h
echo "#endif" >> m.h

##############################################################################
# Configure the native-code compiler
##############################################################################

arch=none
model=default
system=unknown

nativecc=''
nativecccompopts=''
nativecclinkopts=''

case "$host" in
  #TODO: support system=plan9 at some point?
  i[3456]86-*-linuxaout)        arch=i386; system=linux_aout;;
  i[3456]86-*-linux)            arch=i386; system=linux_elf;;
  i[3456]86-*-*bsd*)            arch=i386; system=bsd;;
  #TODO: port amd64 so can compile with arch=amd64; system=linux_elf
  #TODO: port arm64 so can compile with arch=arm64; system=linux_elf
esac

# claude: deliberately no x86_64-*-linux* or aarch64-*-linux* case above
# defaulting to arch=i386/arch=arm: a 64-bit host has no native-code
# backend of its own yet, and silently cross-compiling to a 32-bit arch
# there (as this used to do -- x86_64 via gcc -m32, aarch64 via
# arm-linux-gnueabihf-) would get in the way once amd64/arm64 get a real
# native backend (that case would then need to mean "compile natively for
# amd64/arm64", not "cross-compile to i386/arm32"). So a 64-bit host gets
# arch=none (native-code compiler "not supported on this platform", same
# as any other unlisted host) unless -target-arch explicitly asks for a
# cross target: -target-arch i386 for the i386 target (host's own -m32
# multilib on an x86_64 host, or the i686-linux-gnu- toolchain otherwise),
# or -target-arch arm/arm32 for the arm-linux-gnueabihf- toolchain, or
# -target-arch mips for the mipsel-linux-gnu- toolchain, or -target-arch
# alpha for the alpha-linux-gnu- toolchain, or -target-arch m68k for the
# m68k-linux-gnu- toolchain. Only wires up targets with a known cross
# toolchain in the case blocks below (nativecc, then
# nativecccompopts/nativecclinkopts, then as/aspp).
case "$target_arch" in
  "") ;;
  i386)      arch=i386; system=linux_elf;;
  arm|arm32) arch=arm;   system=linux_elf;;
  mips)      arch=mips;  system=linux_elf;;
  alpha)     arch=alpha; system=linux_elf;;
  m68k)      arch=m68k;  system=linux_elf;;
  sparc)     arch=sparc; system=linux_elf;;
  # claude: asmcomp/power/arch.ml's `toc`/`powerpc` values are keyed off
  # $(SYSTEM)/$(MODEL) (see there) -- "elf" (not "linux_elf" like every
  # other target here) is the exact string that source's `toc` match
  # expects for the SVR4/Linux absolute-addressing model, and "ppc" is
  # what its `powerpc` match expects to mean "PowerPC, not old POWER/
  # RS6000". Both are dead-code-free only for this combination; see the
  # comment on Arch.toc for what was deliberately not restored (AIX,
  # Rhapsody).
  power|powerpc) arch=power; system=elf; model=ppc;;
  *) echo "Unknown -target-arch '$target_arch' (supported: i386, arm/arm32, mips, alpha, m68k, sparc, power/powerpc)" 1>&2
     exit 2;;
esac

case "$arch,$system,$cc" in
  arm,linux_elf,gcc*)   nativecc="arm-linux-gnueabihf-gcc";;
  mips,linux_elf,gcc*)  nativecc="mipsel-linux-gnu-gcc";;
  alpha,linux_elf,gcc*) nativecc="alpha-linux-gnu-gcc";;
  m68k,linux_elf,gcc*)  nativecc="m68k-linux-gnu-gcc";;
  # claude: there is no plain "sparc-linux-gnu-gcc" cross package on
  # Debian/Ubuntu, only the biarch sparc64-linux-gnu-gcc (like
  # x86_64-linux-gnu-gcc's own -m32 mode for i386) -- -m32 (added to
  # nativecccompopts below) makes it emit 32-bit sparc v8/v8plus code,
  # matching asmcomp/sparc/arch.ml's size_int/size_addr = 4.
  sparc,linux_elf,gcc*) nativecc="sparc64-linux-gnu-gcc";;
  # claude: unlike sparc/i386, there IS a plain 32-bit-only cross
  # compiler here (powerpc-linux-gnu-gcc, not the biarch
  # powerpc64-linux-gnu-gcc) -- no -m32-equivalent flag needed below.
  power,elf,gcc*)       nativecc="powerpc-linux-gnu-gcc";;
  *)                    nativecc="$bytecc";;
esac

# claude: the i386 default above ($bytecc, i.e. the host's own gcc) only
# works when the host can build i386 itself: natively (i[3456]86 host) or
# via gcc's -m32 multilib support (x86_64 host, see nativecccompopts
# below). On any other host -- e.g. this aarch64 host cross-compiling to
# i386 via -target-arch i386 -- $bytecc is an aarch64 compiler with no
# -m32 mode, so use the installed i686-linux-gnu-gcc cross compiler
# instead.
case "$arch,$host" in
  i386,i[3456]86-*|i386,x86_64-*) ;;  # native or -m32 multilib: keep $bytecc
  i386,*)                         nativecc="i686-linux-gnu-gcc";;
esac

#TODO: could also case on $host here for crosscompiling settings
case "$arch,$nativecc,$system" in
    #TODO: support amd64
    i386,gcc*,*)
	nativecccompopts='-m32 -Wall --std=gnu89'
	nativecclinkopts='-m32';;
    arm,*,*)
	# can add -O0 -fno-inline -ggdb  to help debug segfaults
	# claude: -marm forces the C runtime (asmrun/*.c) to compile to
	# plain 32-bit ARM instructions. Without it, this cross-compiler
	# defaults to the Thumb-2 instruction encoding, which the
	# hand-written ARM assembly in asmrun/arm.S and the code generated
	# by asmcomp/arm/emit.mlp do not expect (e.g. caml_c_call's
	# "mov pc, r10" to call a C runtime function assumes the callee is
	# ARM code; the CPU stays in ARM mode across such a plain "mov pc",
	# so a Thumb callee gets its instructions misread as ARM and the
	# program crashes almost immediately).
	nativecccompopts='-Wall --std=gnu89  -march=armv7-a -mfpu=vfpv3-d16 -mfloat-abi=hard -marm';;
    mips,*,*)
	# claude: asmcomp/mips/emit.mlp (and the hand-written asmrun/mips.S)
	# generate absolute-addressing code that never sets up $gp (see
	# their "pic = false" / "#ifndef _PIC" paths) -- the classic
	# non-abicalls MIPS model, where $gp is initialized once by crt0
	# and never touched again. mipsel-linux-gnu-gcc defaults to
	# -mabicalls (Linux's usual position-independent calling
	# convention, which reloads $gp on every call), so without
	# -mno-abicalls -fno-pic, the C runtime (asmrun/*.c) would use a
	# calling convention incompatible with the plain "jal symbol" the
	# OCaml-generated code and mips.S both use to call into it.
	nativecccompopts='-Wall --std=gnu89 -mno-abicalls -fno-pic'
	nativecclinkopts='-mno-abicalls -fno-pic -static';;
    alpha,*,*)
	# claude: unlike MIPS, Alpha's ELF calling convention always
	# manages $gp (there is no -mno-abicalls-style opt-out) -- both
	# alpha-linux-gnu-gcc and asmcomp/alpha/emit.mlp's own Ireloadgp
	# reload-insertion pass already follow that same standard
	# convention, so no special compile flags are needed here, unlike
	# mips/arm above. -static is just for convenience under
	# qemu-alpha (no need to have mipsel/armhf-style target shared
	# libraries around).
	#
	# claude: -Wl,--no-relax is required, not just an optimization
	# toggle: alpha-linux-gnu-ld's default GP-relative "literal"
	# relaxation pass miscomputes the offset of at least one .got
	# entry referenced from our hand-emitted (non-gcc) assembly,
	# observed as e.g. Pervasives_entry reading a stray zero instead
	# of the "Pervasives" global-data block's address and segfaulting
	# on the very first native program run. --relax's other target
	# backends (arm, mips, i386) were not affected by this, and
	# disabling it costs only a small code-size increase.
	nativecccompopts='-Wall --std=gnu89'
	nativecclinkopts='-static -Wl,--no-relax';;
    m68k,*,*)
	# claude: m68k-linux-gnu-gcc already defaults to -mcpu=68020 with
	# the 68881/68882 FPU enabled (-m68881 is "[enabled]" by default),
	# matching what asmcomp/m68k/emit.mlp assumes (fmoved/fintrz/etc.),
	# so no special compile flags are needed here. -static is just for
	# convenience under qemu-m68k.
	nativecccompopts='-Wall --std=gnu89'
	nativecclinkopts='-static'
	;;
    sparc,*,*)
	# claude: -m32 is required (see the nativecc comment above) --
	# without it sparc64-linux-gnu-gcc compiles asmrun/*.c as 64-bit
	# sparc64 code, which asmcomp/sparc/emit.mlp (32-bit registers,
	# calling_conventions, etc.) does not generate or expect. -static
	# is just for convenience under qemu-sparc32plus.
	nativecccompopts='-Wall --std=gnu89 -m32'
	nativecclinkopts='-m32 -static'
	;;
    power,*,*)
	# claude: powerpc-linux-gnu-gcc already defaults to 32-bit big-endian
	# code matching asmcomp/power/arch.ml, so no special compile flags
	# are needed here. -static is just for convenience under qemu-ppc.
	nativecccompopts='-Wall --std=gnu89'
	nativecclinkopts='-static'
esac

# claude: same native-vs-cross split as the nativecc override above -- the
# i386,gcc*,* case just above assumes -m32 works ($bytecc is either
# already i386, or an x86_64 gcc with multilib support). The cross
# compiler selected above for other hosts is already an i386-only
# compiler, so it needs no -m32/-march flags at all.
case "$arch,$nativecc" in
  i386,i686-linux-gnu-gcc) nativecccompopts='-Wall --std=gnu89';;
esac

# claude: this used to say "TODO: define as='' at some point too" -- no
# AS= was ever written to Makefile, so plain `make`/`$(AS)` fell back to
# make's builtin default (the *host*'s own "as", not a cross assembler).
# That's harmless on a native (non-cross) build where the host's as is
# also correct for the target, but on this aarch64-host/arm-target cross
# build it broke testasmcomp/Makefile, which invokes $(AS) $(ASFLAGS)
# directly on hand-written .s files (unlike the rest of the build, which
# goes through $(ASPP), a C-compiler wrapper, for .S/.s files that need
# preprocessing) -- "Error: unknown architecture `armv7-a'" from the
# host's own as, given arm flags it doesn't understand.
as=''
asflags=''
aspp='$(AS)'
asppflags=''

case "$arch,$model,$system" in
    #TODO: support amd64
    i386,*,*)
        aspp='gcc'
	asflags='--32'
	asppflags='-m32 -c -DSYS_$(SYSTEM)';;
    #TODO: support arm64
    arm,*,*)
        as='arm-linux-gnueabihf-as'
        aspp='arm-linux-gnueabihf-gcc'
	asflags='-march=armv7-a -mfpu=vfpv3-d16 -mfloat-abi=hard'
	asppflags='-O0 -fno-inline -ggdb -c -DSYS_$(SYSTEM) -march=armv7-a -mfpu=vfpv3-d16 -mfloat-abi=hard';;
    mips,*,*)
        as='mipsel-linux-gnu-as'
        aspp='mipsel-linux-gnu-gcc'
	asppflags='-mno-abicalls -fno-pic -c -DSYS_$(SYSTEM)';;
    alpha,*,*)
        as='alpha-linux-gnu-as'
        aspp='alpha-linux-gnu-gcc'
	asppflags='-c -DSYS_$(SYSTEM)';;
    m68k,*,*)
        as='m68k-linux-gnu-as'
        aspp='m68k-linux-gnu-gcc'
	asppflags='-c -DSYS_$(SYSTEM)';;
    sparc,*,*)
        as='sparc64-linux-gnu-as'
        aspp='sparc64-linux-gnu-gcc'
	asflags='-32'
	asppflags='-m32 -c -DSYS_$(SYSTEM)';;
    power,*,*)
        as='powerpc-linux-gnu-as'
        aspp='powerpc-linux-gnu-gcc'
	asppflags='-c -DSYS_$(SYSTEM)';;
esac

# claude: mirrors the nativecc/nativecccompopts native-vs-cross split
# above -- the plain host `as`/`gcc` used by the i386 case just above only
# work when the host itself is (or can multilib-produce) i386. When
# cross-compiling i386 from a host that can't (aarch64 here), route both
# the plain assembler (asmcomp/i386/proc.ml's assemble_file, via
# Config.asm/Config.asm_flags below) and the preprocessed assembler
# (asmrun/*.S, via ASPP/ASPPFLAGS) through the installed i686-linux-gnu-*
# cross toolchain instead, dropping the now-redundant -m32/--32 (those
# cross tools already target i386 by default).
case "$arch,$nativecc" in
  i386,i686-linux-gnu-gcc)
    as='i686-linux-gnu-as'
    asflags=''
    aspp='i686-linux-gnu-gcc'
    asppflags='-c -DSYS_$(SYSTEM)';;
esac

echo "ARCH=$arch" >> Makefile
echo "MODEL=$model" >> Makefile
if test -n "$as"; then echo "AS=$as" >> Makefile; fi
echo "SYSTEM=$system" >> Makefile
echo "NATIVECC=$nativecc" >> Makefile
echo "NATIVECCCOMPOPTS=$nativecccompopts" >> Makefile
echo "NATIVECCLINKOPTS=$nativecclinkopts" >> Makefile
echo "ASFLAGS=$asflags" >> Makefile
echo "ASPP=$aspp" >> Makefile
echo "ASPPFLAGS=$asppflags" >> Makefile

# Where is ranlib?

if sh ./searchpath ranlib; then
  echo "ranlib found"
  echo "RANLIB=ranlib" >> Makefile
  echo "RANLIBCMD=ranlib" >> Makefile
else
  echo "ranlib not used"
  echo "RANLIB=ar rs" >> Makefile
  echo "RANLIBCMD=" >> Makefile
fi

# Do #! scripts work?

if (SHELL=/bin/sh; export SHELL; ./sharpbang > /dev/null); then
  echo "#! appears to work in shell scripts"
  case "$host" in
    *-*-sunos*)
      if test `echo $bindir/ocamlrun | wc -c` -gt 32; then
        echo "We won't use it, though, because the path"
        echo "      $bindir/ocamlrun"
        echo "is too long (more than 32 characters -- some kernels don't support this)"
        echo "SHARPBANGSCRIPTS=false" >> Makefile
      else
        echo "SHARPBANGSCRIPTS=true" >> Makefile
      fi;;
    *)  echo "SHARPBANGSCRIPTS=true" >> Makefile;;
  esac
else
  echo "No support for #! in shell scripts"
  echo "SHARPBANGSCRIPTS=false" >> Makefile
fi

# This is obviously a Unix system

echo '#define OCAML_OS_TYPE "Unix"' >> s.h

# Find a good byte move function

if sh ./runtest -Dcopy=memmove -Dreverse bytecopy.c; then
  echo "Function \"memmove\" is provided and handles overlapping moves correctly."
  echo "#define HAS_MEMMOVE" >> s.h
fi
if sh ./runtest -Dcopy=bcopy bytecopy.c; then
  echo "Function \"bcopy\" is provided and handles overlapping moves correctly."
  echo "#define HAS_BCOPY" >> s.h
fi

# Check the semantics of signal handlers

if sh ./hasgot sigaction sigprocmask; then
  echo "POSIX signal handling found."
  echo "#define POSIX_SIGNALS" >> s.h
else
  if sh ./runtest signals.c; then
    echo "Signals have the BSD semantics."
    echo "#define BSD_SIGNALS" >> s.h
  else
    echo "Signals have the System V semantics."
  fi
  if sh ./hasgot sigsetmask; then
    echo "sigsetmask() found"
    echo "#define HAS_SIGSETMASK" >> s.h
  fi
fi

# For the sys module

if sh ./hasgot times; then
  echo "times() found."
  echo "#define HAS_TIMES" >> s.h
fi

# For the terminfo module

#pad: ugly: disable ncurses for now because there is no /usr/lib32/libncurses.a
# and that can cause issue with ocamlopt if we want to statically link
# binaries. Anyway it is just used in parsing/location.ml to highlight
# errors and is a optional.

#for libs in "" "-lcurses" "-ltermcap" "-lcurses -ltermcap"; do
#  if sh ./hasgot $libs tgetent tgetstr tgetnum tputs; then
#    echo "termcap functions found (with libraries '$libs')"
#    echo "#define HAS_TERMCAP" >> s.h
#    cclibs="${cclibs}${libs}"
#    break
#  fi
#done

##############################################################################
# Configuration for the libraries
##############################################################################

otherlibraries="unix str num dynlink"

# For the Unix library

has_sockets=no
if sh ./hasgot socket socketpair bind listen accept connect; then
  echo "You have BSD sockets."
  echo "#define HAS_SOCKETS" >> s.h
  has_sockets=yes
elif sh ./hasgot -lnsl -lsocket socket socketpair bind listen accept connect; then
  echo "You have BSD sockets (with libraries '-lnsl -lsocket')"
  cclibs="$cclibs -lnsl -lsocket"
  echo "#define HAS_SOCKETS" >> s.h
  has_sockets=yes
fi

#pad: I've removed some HAS_STRERROR test, to simplify code
# so it's not tested/detected here anymore
#TODO: should hasgot -i stdlib.h, seems more standard now

if sh ./hasgot -i unistd.h; then
  echo "unistd.h found."
  echo "#define HAS_UNISTD" >> s.h
fi

if sh ./hasgot -i dirent.h; then
  echo "dirent.h found."
  echo "#define HAS_DIRENT" >> s.h
fi

if sh ./hasgot rewinddir; then
  echo "rewinddir() found."
  echo "#define HAS_REWINDDIR" >> s.h
fi

if sh ./hasgot lockf; then
  echo "lockf() found."
  echo "#define HAS_LOCKF" >> s.h
fi

if sh ./hasgot mkfifo; then
  echo "mkfifo() found."
  echo "#define HAS_MKFIFO" >> s.h
fi

if sh ./hasgot getcwd; then
  echo "getcwd() found."
  echo "#define HAS_GETCWD" >> s.h
fi

if sh ./hasgot getwd; then
  echo "getwd() found."
  echo "#define HAS_GETWD" >> s.h
fi

if sh ./hasgot getpriority setpriority; then
  echo "getpriority() found."
  echo "#define HAS_GETPRIORITY" >> s.h
fi

if sh ./hasgot -i utime.h && sh ./hasgot utime; then
  echo "utime() found."
  echo "#define HAS_UTIME" >> s.h
fi

if sh ./hasgot utimes; then
  echo "utimes() found."
  echo "#define HAS_UTIMES" >> s.h
fi

if sh ./hasgot dup2; then
  echo "dup2() found."
  echo "#define HAS_DUP2" >> s.h
fi

if sh ./hasgot fchmod fchown; then
  echo "fchmod() found."
  echo "#define HAS_FCHMOD" >> s.h
fi

if sh ./hasgot truncate ftruncate; then
  echo "truncate() found."
  echo "#define HAS_TRUNCATE" >> s.h
fi

has_select=no
if sh ./hasgot select; then
  echo "select() found."
  echo "#define HAS_SELECT" >> s.h
  has_select=yes
fi

if sh ./hasgot -i sys/select.h; then
  echo "sys/select.h found."
  echo "#define HAS_SYS_SELECT_H" >> s.h
fi

if sh ./hasgot symlink readlink lstat;  then
  echo "symlink() found."
  echo "#define HAS_SYMLINK" >> s.h
fi

has_wait=no
if sh ./hasgot waitpid;  then
  echo "waitpid() found."
  echo "#define HAS_WAITPID" >> s.h
  has_wait=yes
fi

if sh ./hasgot wait4;  then
  echo "wait4() found."
  echo "#define HAS_WAIT4" >> s.h
  has_wait=yes
fi

if sh ./hasgot -i sys/param.h && sh ./runtest getgroups.c; then
  echo "getgroups() found."
  echo "#define HAS_GETGROUPS" >> s.h
fi

if sh ./hasgot -i termios.h && 
   sh ./hasgot tcgetattr tcsetattr tcsendbreak tcflush tcflow; then
  echo "POSIX termios found."
  echo "#define HAS_TERMIOS" >> s.h
fi

# Async I/O under OSF1 3.x are so buggy that the test program hangs...
testasyncio=true
if test -f /usr/bin/uname; then
  case "`/usr/bin/uname -s -r`" in
    "OSF1 V3."*) testasyncio=false;;
  esac
fi
if $testasyncio && sh ./runtest async_io.c; then
  echo "Asynchronous I/O are supported."
  echo "#define HAS_ASYNC_IO" >> s.h
fi

has_setitimer=no
if sh ./hasgot setitimer; then
  echo "setitimer() found."
  echo "#define HAS_SETITIMER" >> s.h
  has_setitimer="yes"
fi

if sh ./hasgot gethostname; then
  echo "gethostname() found."
  echo "#define HAS_GETHOSTNAME" >> s.h
fi

if sh ./hasgot -i sys/utsname.h && sh ./hasgot uname; then
  echo "uname() found."
  echo "#define HAS_UNAME" >> s.h
fi

has_gettimeofday=no
if sh ./hasgot gettimeofday; then
  echo "gettimeofday() found."
  echo "#define HAS_GETTIMEOFDAY" >> s.h
  has_gettimeofday="yes"
fi

if sh ./hasgot mktime; then
  echo "mktime() found."
  echo "#define HAS_MKTIME" >> s.h
fi

if sh ./hasgot setsid; then
  echo "setsid() found."
  echo "#define HAS_SETSID" >> s.h
fi

# Determine if the debugger is supported

if test "$has_sockets" = "yes"; then
  echo "Replay debugger supported."
  debugger="ocamldebugger"
else
  echo "No replay debugger (missing system calls)"
  debugger=""
fi

# Determine the target architecture for the "num" library

#TODO? detect x86_64 and compile lib with -m32?
case "$host" in
  i[3456]86-*-linux) bignum_arch=x86;;
  #TODO: add arm and arm64 code for bignum?
  *) bignum_arch=C
esac

echo "BIGNUM_ARCH=$bignum_arch" >> Makefile

# Determine if the threads library is supported

if test "$posix_threads" = "yes"; then
  echo "Threads library supported (using POSIX system threads)."
  otherlibraries="$otherlibraries systhreads"
elif test "$has_select" = "yes" \
&& test "$has_setitimer" = "yes" \
&& test "$has_gettimeofday" = "yes" \
&& test "$has_wait" = "yes"; then
  echo "Threads library supported."
  otherlibraries="$otherlibraries threads"
else
  echo "No threads library (missing system calls)"
fi

# Determine the location of X include files and libraries

#alt: we could remove all of that as otherlibs/graphics/ got later
# moved out of the ocaml repo, but graphics is useful for efuns
# so let's keep it

x11_include="not found"
x11_link="not found"

for dir in $x11_include_dir \
  /usr/include /usr/local/include \
  /usr/X11R6/include /usr/X11R5/include /usr/X11R4/include \
  /usr/include/X11R6 /usr/include/X11R5 /usr/include/X11R4 \
  /usr/local/X11R6/include /usr/local/X11R5/include /usr/local/X11R4/include \
  /usr/local/include/X11R6 /usr/local/include/X11R5 /usr/local/include/X11R4 \
  /usr/X11/include /usr/include/X11 /usr/local/X11/include \
  /usr/local/include/X11 /usr/X386/include /usr/x386/include \
  /usr/XFree86/include/X11 \
  /usr/unsupported/include /usr/athena/include /usr/local/x11r5/include \
  /usr/lpp/Xamples/include /usr/openwin/include /usr/openwin/share/include \
  /opt/X11R6/include /opt/X11R5/include
do
  if test -f $dir/X11/X.h; then
    echo "Found $dir/X11/X.h"
    x11_include=$dir
    break
  fi
done

for dir in $x11_lib_dir \
  /usr/lib /usr/local/lib \
  /usr/lib/x86_64-linux-gnu/ /usr/lib/aarch64-linux-gnu \
  /usr/X11R6/lib /usr/X11R5/lib /usr/X11R4/lib \
  /usr/lib/X11R6 /usr/lib/X11R5 /usr/lib/X11R4 \
  /usr/local/X11R6/lib /usr/local/X11R5/lib /usr/local/X11R4/lib \
  /usr/local/lib/X11R6 /usr/local/lib/X11R5 /usr/local/lib/X11R4 \
  /usr/X11/lib /usr/lib/X11 /usr/local/X11/lib \
  /usr/local/lib/X11 /usr/X386/lib /usr/x386/lib \
  /usr/XFree86/lib/X11 \
  /usr/unsupported/lib /usr/athena/lib /usr/local/x11r5/lib \
  /usr/lpp/Xamples/lib /usr/openwin/lib /usr/openwin/share/lib \
  /opt/X11R6/lib /opt/X11R5/lib
do
  if test -f $dir/libX11.a || \
     test -f $dir/libX11.so || \
     test -f $dir/libX11.sa; then
    echo "Found $dir/libX11.a or $dir/libX11.so"
    x11_link="-cclib -L$dir -cclib -lX11"
    break
  fi
done


if test "$x11_include" = "not found" || test "$x11_link" = "not found"
then
  echo "X11 not found, the \"graph\" library will not be supported."
else
  echo "Location of X11 include files: $x11_include/X11"
  echo "Options for linking with X11: $x11_link"
  otherlibraries="$otherlibraries graph"
  if test "$x11_include" = "/usr/include"; then
    x11_include=""
  else
    x11_include="-I$x11_include"
  fi
  echo "X11_INCLUDES=$x11_include" >> Makefile
  echo "X11_LINK=$x11_link" >> Makefile
fi

# See if we can compile the dbm library

if sh ./hasgot -i ndbm.h
then
  echo "NDBM library found."
  otherlibraries="$otherlibraries dbm"
else
  echo "NDBM not found, the \"dbm\" library will not be supported."
fi

##############################################################################
# Finish generated files
##############################################################################

cclibs="$cclibs -lm"
echo "CCLIBS=$cclibs" >> Makefile
echo "OTHERLIBRARIES=$otherlibraries" >> Makefile
echo "DEBUGGER=$debugger" >> Makefile

rm -f tst hasgot.c
rm -f ../m.h ../s.h ../Makefile
mv m.h s.h Makefile ..

##############################################################################
# Print a summary
##############################################################################

echo
echo "** Configuration summary **"
echo
echo "Directories where OCaml light will be installed:"
echo "	binaries.................. $bindir"
echo "	standard library.......... $libdir"
echo "	manual pages.............. $mandir (with extension .$manext)"

echo "Configuration for the bytecode compiler:"
echo "	C compiler used........... $bytecc"
echo "	options for compiling..... $bytecccompopts"
echo "	options for linking....... $bytecclinkopts $cclibs"

echo "Configuration for the native-code compiler:"
if test "$arch" = "none"; then
  echo "	(not supported on this platform, use -target-arch otherwise)"
else
  if test "$model" = "default"; then
    echo "	hardware architecture..... $arch"
  else
    echo "	hardware architecture..... $arch ($model)"
  fi
  if test "$system" = "unknown"; then : ; else
  echo "	OS variant................ $system"
  fi
  echo "	C compiler used........... $nativecc"
  echo "	options for compiling..... $nativecccompopts"
  echo "	options for linking....... $nativecclinkopts $cclibs"
  # pad: \$(AS) because there is no configure -as ... yet nor a
  # config/Makefile entry for AS=... We use gcc as a frontend for the
  # assembler via ASPP in most of our Makefiles (we use 'as' directly though
  # in the asmcomp/<arch>/proc.ml).
  # The only direct use of the AS is in testsasmcomp/Makefile
  echo "        assembler ................ \$(AS) $asflags"
  echo "        preprocessed assembler ... $aspp $asppflags"
fi

if test "$debugger" = "ocamldebugger"; then
  echo "Source-level replay debugger: supported"
else
  echo "Source-level replay debugger: not supported"
fi

echo "Configuration for the external libraries:"
echo "	libraries supported....... $otherlibraries"

echo "The \"num\" library:"
echo "	target architecture ...... $bignum_arch"

if test "$x11_include" != "not found" && test "$x11_lib" != "not found"; then
echo "The \"graph\" library:"
echo "	options for compiling .... $x11_include"
echo "	options for linking ...... $x11_link"
fi
