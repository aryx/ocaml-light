#!/bin/sh
# Run a native-code ($(CODE_EXE)) test/example binary built for the
# configured -target-arch, using a qemu-user front-end when that arch
# cannot run directly on this host (e.g. mips, alpha, m68k, sparc, power).
#
# This is deliberately explicit rather than relying on qemu-binfmt /
# binfmt_misc registration: that registration is host/kernel-wide, not
# scoped to a single `docker build`, and has proven fragile to set up
# reliably across plain Docker and GitHub Actions runners. Invoking the
# right qemu-<arch> ourselves needs nothing beyond the qemu-user package
# being installed, works the same in any container, and fails with a
# clear "command not found" instead of a silent/confusing exec error.
#
# Usage: run-native <binary> [args...]

arch=`sed -n 's/^ARCH=//p' "$(dirname "$0")/../config/Makefile" | tail -1`

case "$arch" in
  mips)  exec qemu-mipsel-static "$@" ;;
  alpha) exec qemu-alpha-static "$@" ;;
  m68k)  exec qemu-m68k-static "$@" ;;
  # claude: sparc64-linux-gnu-gcc -m32 (see configure's -target-arch
  # sparc case) emits binaries flagged EF_SPARC_32PLUS -- qemu-sparc
  # (plain v8) refuses to run them ("Invalid ELF image for this
  # architecture"), only qemu-sparc32plus accepts that flavor.
  sparc) exec qemu-sparc32plus-static "$@" ;;
  power) exec qemu-ppc-static "$@" ;;
  # claude: unlike i386 (host -m32 multilib) and arm (aarch64's AArch32
  # CPU-level compat mode), there is no such shortcut for amd64 on this
  # aarch64 dev host, so route it through qemu-user-static too, same as
  # mips/alpha/m68k/sparc/power above -- this also makes the Docker
  # native-amd64 target below work the same regardless of whether its
  # host happens to already be x86_64.
  amd64) exec qemu-x86_64-static "$@" ;;
  # claude: this dev host happens to already be aarch64 (where this
  # would run natively via the "*" case below), but the Docker
  # native-arm64 target must also work on an x86_64 CI runner, so route
  # it through qemu-user-static unconditionally too, same as amd64 above.
  arm64) exec qemu-aarch64-static "$@" ;;
  *)     exec "$@" ;;
esac
